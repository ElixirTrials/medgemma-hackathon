# Copy to .env and set your values. Do not commit .env.
#
# GemmaCrit supports two MedGemma deployment backends:
#   Option A: Vertex AI Model Garden (cloud, recommended for production)
#   Option B: Local GPU via HuggingFace (requires NVIDIA GPU with 8GB+ VRAM)

# ──────────────────────────────────────────────────
# REQUIRED: Gemini (extraction, structuring, ordinal resolution)
# ──────────────────────────────────────────────────

# Gemini Developer API key (required for all pipelines)
# Get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Gemini model for criteria extraction (default: gemini-2.5-flash)
GEMINI_MODEL_NAME=gemini-2.5-flash

# ──────────────────────────────────────────────────
# REQUIRED: UMLS (terminology grounding)
# ──────────────────────────────────────────────────

# Get a key at https://uts.nlm.nih.gov/uts/signup-login
UMLS_API_KEY=

# Optional UMLS overrides
# UMLS_BASE_URL=https://uts-ws.nlm.nih.gov/rest
# UMLS_CACHE_DIR=
# UMLS_TIMEOUT_SECONDS=10

# ──────────────────────────────────────────────────
# MedGemma Backend — Option A: Vertex AI (recommended)
# ──────────────────────────────────────────────────

MODEL_BACKEND=vertex
GCP_PROJECT_ID=
GCP_REGION=europe-west4
VERTEX_ENDPOINT_ID=
# Alternative: use a named model instead of endpoint ID
# VERTEX_MODEL_NAME=

# ──────────────────────────────────────────────────
# MedGemma Backend — Option B: Local GPU
# ──────────────────────────────────────────────────

# Uncomment and set MODEL_BACKEND=local to use local GPU inference
# MODEL_BACKEND=local
# MEDGEMMA_MODEL_PATH=google/medgemma-4b-it
# MEDGEMMA_QUANTIZATION=4bit
# MEDGEMMA_MAX_TOKENS=2048

# ──────────────────────────────────────────────────
# Optional: Google OAuth (UI login)
# ──────────────────────────────────────────────────

# Create at: https://console.cloud.google.com/apis/credentials
# Redirect URI: http://localhost:8000/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ──────────────────────────────────────────────────
# Optional: GCloud / ADC
# ──────────────────────────────────────────────────

# GCloud configuration profile (activated by make run-dev / run-api).
# make run-dev runs gcloud auth login (browser) so you are not prompted for a password.
GCLOUD_PROFILE=
# Quota project for Application Default Credentials
# GOOGLE_CLOUD_QUOTA_PROJECT=

# ──────────────────────────────────────────────────
# Observability: MLflow
# ──────────────────────────────────────────────────

# When running locally via "make run-dev", MLflow runs on localhost:5001
MLFLOW_TRACKING_URI=http://localhost:5001

# ──────────────────────────────────────────────────
# Dev / debug: limit criteria and grounding for faster runs
# ──────────────────────────────────────────────────
# Limit how many criteria are used from extraction (parse node) and thus how many
# entities are decomposed and grounded. Reduces API calls for quicker iteration.
# Unset or 0 = no limit. Example: 10 criteria and up to 10 entities to ground.
# DEV_MAX_CRITERIA=10
# DEV_MAX_ENTITIES=10

# For Docker Compose and full stack, see infra/.env.example
# (DATABASE_URL, API_PORT, GCS_BUCKET_NAME, etc.)
